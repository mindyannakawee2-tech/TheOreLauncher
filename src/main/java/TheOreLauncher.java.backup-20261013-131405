        add(brand, BorderLayout.NORTH);

        JPanel center = new JPanel(new GridBagLayout()); center.setBackground(PANEL);
        center.setBorder(new EmptyBorder(30, 40, 30, 40));
        GridBagConstraints c = new GridBagConstraints(); c.gridx=0; c.fill=GridBagConstraints.HORIZONTAL;
        c.weightx=1; c.insets=new Insets(7, 0, 7, 0);
        JLabel headline = new JLabel("THEORE  /  Java 2D RPG", SwingConstants.CENTER);
        headline.setForeground(WHITE); headline.setFont(new Font("SansSerif", Font.BOLD, 27));
        c.gridy=0; center.add(headline,c);
        JLabel sub = new JLabel("Explore  •  Discover  •  Create", SwingConstants.CENTER);
        sub.setForeground(new Color(173,189,199)); c.gridy=1;center.add(sub,c);
        JLabel label = new JLabel("CHOOSE A GITHUB RELEASE");label.setForeground(GOLD);
        c.gridy=2; c.insets=new Insets(28,0,4,0); center.add(label,c);
        versions.setFont(new Font("SansSerif",Font.PLAIN,15));
        c.gridy=3; c.insets=new Insets(4,0,7,0); center.add(versions,c);
        play.setFont(new Font("SansSerif",Font.BOLD,19)); play.setBackground(new Color(56,135,84));
        play.setForeground(Color.WHITE); play.setFocusPainted(false);
        c.gridy=4; c.insets=new Insets(10,0,6,0);center.add(play,c);
        refresh.setBackground(new Color(56,67,80));refresh.setForeground(WHITE);refresh.setFocusPainted(false);
        c.gridy=5; c.insets=new Insets(3,0,7,0);center.add(refresh,c);
        progress.setStringPainted(true);progress.setVisible(false);
        c.gridy=6; center.add(progress,c);
        add(center,BorderLayout.CENTER);
        status.setForeground(new Color(190,201,211));status.setBorder(new EmptyBorder(13,22,13,22));
